{
  "schemaVersion": 1,
  "id": "cinema_scope",
  "version": "${version}",
  "name": "Cinema Scope",
  "description": "Cinematic mode for 1.20.1: press K to hide the HUD, slide in letterbox bars and zoom in smoothly. Based on CinemaScope by heconis (MIT).",
  "authors": ["heconis (original)", "ChopstickGuy (1.20.1 port)"],
  "license": "MIT",
  "icon": "assets/cinema_scope/icon.png",
  "environment": "client",
  "entrypoints": { "client": ["cinemascope.CinemaScopeClient"] },
  "mixins": ["cinema_scope.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "~1.20.1",
    "fabric-api": "*"
  }
}
